# Optional AI provider. If omitted, all AI routes return local mock responses.
# One key unlocks: /api/ai/suggest, /api/ai/layout, /api/ai/placement, /api/ai/chat
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Anthropic placeholder (not wired in v1 — future provider option)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Optional: override where mock submission logs are saved during development.
# Defaults to your OS temp directory.
LOCAL_SUBMISSION_DIR=""
